{
  "$schema": "https://opencode.ai/config.json",
  "lsp": true,
  "model": "ollama/qwen3.6-32k-nothink:latest",
  "small_model": "ollama/qwen3.6-32k-nothink:latest",
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "qwen3.6-32k-nothink:latest": {
          "name": "Qwen 3.6 32k nothink (local)",
          "tool_call": true,
          "options": {
            "temperature": 0.1,
            "reasoningEffort": "none"
          },
          "limit": {
            "context": 32768,
            "output": 8192
          },
          "cost": {
            "input": 0,
            "output": 0
          }
        }
      }
    }
  }
}